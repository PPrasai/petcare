{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://petcare.pprasai.io/contracts/records.schema.json",
  "title": "PetCare synced records (CON-petcare-003)",
  "description": "Authoritative shapes of every synced record type. A record = common envelope + type-specific `data`. Units: SI for measurements; integer minor units + ISO 4217 for money; YYYY-MM-DD for calendar dates; ISO 8601 UTC instants.",
  "$ref": "#/$defs/Record",
  "$defs": {
    "Uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "Date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "Instant": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "Currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "MoneyMinor": { "type": "integer", "minimum": 0, "maximum": 100000000000 },
    "ShortText": { "type": "string", "minLength": 1, "maxLength": 200 },
    "Note": { "type": "string", "maxLength": 5000 },
    "NullableUuid": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
    "NullableDate": { "oneOf": [{ "$ref": "#/$defs/Date" }, { "type": "null" }] },
    "FileIds": { "type": "array", "items": { "$ref": "#/$defs/Uuid" }, "maxItems": 20, "uniqueItems": true },
    "RecordType": {
      "enum": ["pet", "measurement", "vaccination", "medication", "medicationDose", "vetVisit", "condition", "symptomEntry",
               "careRoutine", "careCompletion", "reminder", "reminderCompletion", "reminderSnooze", "document", "expense",
               "contact", "emergencyCard", "careLog", "mealPreset"]
    },
    "Schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tz", "kind", "startOn"],
      "properties": {
        "tz": { "type": "string", "minLength": 1, "maxLength": 64, "description": "IANA time zone, e.g. Asia/Kathmandu" },
        "kind": { "enum": ["once", "daily", "weekly", "monthly", "everyNDays", "yearly"], "description": "yearly: every year on startOn's month and day; 29 Feb clamps to 28 Feb in non-leap years" },
        "times": { "type": "array", "items": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }, "maxItems": 12, "uniqueItems": true, "description": "Local times; empty = all-day item due at 09:00 local" },
        "daysOfWeek": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "uniqueItems": true, "description": "ISO weekday 1=Mon; required when kind=weekly" },
        "dayOfMonth": { "type": "integer", "minimum": 1, "maximum": 31, "description": "Required when kind=monthly; clamps to last day of shorter months" },
        "everyN": { "type": "integer", "minimum": 1, "maximum": 3650, "description": "Required when kind=everyNDays" },
        "startOn": { "$ref": "#/$defs/Date" },
        "endOn": { "$ref": "#/$defs/NullableDate" },
        "notBefore": { "$ref": "#/$defs/Instant", "description": "No occurrence earlier than this instant is generated. Clients set it to the creation or schedule-edit time" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "weekly" } } }, "then": { "required": ["daysOfWeek"], "properties": { "daysOfWeek": { "minItems": 1 } } } },
        { "if": { "properties": { "kind": { "const": "monthly" } } }, "then": { "required": ["dayOfMonth"] } },
        { "if": { "properties": { "kind": { "const": "everyNDays" } } }, "then": { "required": ["everyN"] } }
      ]
    },

    "Envelope": {
      "type": "object",
      "required": ["id", "type", "householdId", "version", "createdAt", "createdBy", "updatedAt", "updatedBy", "deletedAt", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid", "description": "UUIDv7, generated by the client that created the record" },
        "type": { "$ref": "#/$defs/RecordType" },
        "householdId": { "$ref": "#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1, "description": "Server-assigned; increments by 1 on every applied change" },
        "createdAt": { "$ref": "#/$defs/Instant" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 64, "description": "User id (opaque)" },
        "updatedAt": { "$ref": "#/$defs/Instant" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 64 },
        "deletedAt": { "oneOf": [{ "$ref": "#/$defs/Instant" }, { "type": "null" }] },
        "data": { "type": "object" }
      }
    },

    "Record": {
      "oneOf": [
        { "$ref": "#/$defs/PetRecord" }, { "$ref": "#/$defs/MeasurementRecord" }, { "$ref": "#/$defs/VaccinationRecord" },
        { "$ref": "#/$defs/MedicationRecord" }, { "$ref": "#/$defs/MedicationDoseRecord" }, { "$ref": "#/$defs/VetVisitRecord" },
        { "$ref": "#/$defs/ConditionRecord" }, { "$ref": "#/$defs/SymptomEntryRecord" }, { "$ref": "#/$defs/CareRoutineRecord" },
        { "$ref": "#/$defs/CareCompletionRecord" }, { "$ref": "#/$defs/ReminderRecord" }, { "$ref": "#/$defs/ReminderCompletionRecord" },
        { "$ref": "#/$defs/ReminderSnoozeRecord" }, { "$ref": "#/$defs/DocumentRecord" }, { "$ref": "#/$defs/ExpenseRecord" },
        { "$ref": "#/$defs/ContactRecord" }, { "$ref": "#/$defs/EmergencyCardRecord" }, { "$ref": "#/$defs/CareLogRecord" },
        { "$ref": "#/$defs/MealPresetRecord" }
      ]
    },

    "PetRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "pet" }, "data": { "$ref": "#/$defs/PetData" } } }] },
    "PetData": {
      "type": "object", "additionalProperties": false, "required": ["name", "species"],
      "properties": {
        "name": { "$ref": "#/$defs/ShortText" },
        "species": { "enum": ["dog", "cat", "bird", "rabbit", "guineaPig", "hamster", "fish", "reptile", "horse", "other"] },
        "speciesOther": { "type": ["string", "null"], "maxLength": 100 },
        "breed": { "type": ["string", "null"], "maxLength": 100 },
        "isMixedBreed": { "type": "boolean" },
        "sex": { "enum": ["male", "female", "unknown"] },
        "neutered": { "type": ["boolean", "null"] },
        "birthDate": { "$ref": "#/$defs/NullableDate" },
        "birthDateEstimated": { "type": "boolean" },
        "colour": { "type": ["string", "null"], "maxLength": 100 },
        "markings": { "type": ["string", "null"], "maxLength": 500 },
        "microchipId": { "type": ["string", "null"], "maxLength": 32 },
        "photoFileId": { "$ref": "#/$defs/NullableUuid" },
        "adoptedOn": { "$ref": "#/$defs/NullableDate" },
        "insurance": {
          "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false,
            "properties": { "provider": { "type": "string", "maxLength": 100 }, "policyNumber": { "type": "string", "maxLength": 100 }, "renewsOn": { "$ref": "#/$defs/NullableDate" } } }]
        },
        "diet": { "type": ["string", "null"], "maxLength": 1000 },
        "bloodType": { "type": ["string", "null"], "maxLength": 20 },
        "sizeCategory": { "enum": ["toy", "small", "medium", "large", "giant", null] },
        "archivedAt": { "oneOf": [{ "$ref": "#/$defs/Instant" }, { "type": "null" }] },
        "archivedReason": { "enum": ["deceased", "rehomed", "lost", "other", null] }
      }
    },

    "MeasurementRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "measurement" }, "data": { "$ref": "#/$defs/MeasurementData" } } }] },
    "MeasurementData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "kind", "value", "measuredAt"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "kind": { "enum": ["weight", "height", "length", "temperature", "heartRate", "respiratoryRate", "bodyCondition"] },
        "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000, "description": "SI: kg, cm, cm, °C, beats/min, breaths/min, 1–9 scale" },
        "measuredAt": { "$ref": "#/$defs/Instant" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "VaccinationRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "vaccination" }, "data": { "$ref": "#/$defs/VaccinationData" } } }] },
    "VaccinationData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "vaccineName", "givenOn"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "vaccineName": { "$ref": "#/$defs/ShortText" },
        "givenOn": { "$ref": "#/$defs/Date" },
        "batchNumber": { "type": ["string", "null"], "maxLength": 100 },
        "contactId": { "$ref": "#/$defs/NullableUuid" },
        "nextDueOn": { "$ref": "#/$defs/NullableDate" },
        "certificateFileId": { "$ref": "#/$defs/NullableUuid" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "MedicationRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "medication" }, "data": { "$ref": "#/$defs/MedicationData" } } }] },
    "MedicationData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "name", "schedule"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "name": { "$ref": "#/$defs/ShortText" },
        "dose": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "doseUnit": { "enum": ["mg", "ml", "tablet", "capsule", "drop", "puff", "application", "other", null] },
        "schedule": { "$ref": "#/$defs/Schedule" },
        "prescribedByContactId": { "$ref": "#/$defs/NullableUuid" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "MedicationDoseRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "medicationDose" }, "data": { "$ref": "#/$defs/MedicationDoseData" } } }] },
    "MedicationDoseData": {
      "type": "object", "additionalProperties": false, "required": ["medicationId", "petId", "occurrenceAt", "givenAt", "skipped"],
      "properties": {
        "medicationId": { "$ref": "#/$defs/Uuid" },
        "petId": { "$ref": "#/$defs/Uuid" },
        "occurrenceAt": { "$ref": "#/$defs/Instant", "description": "The scheduled occurrence this dose answers" },
        "givenAt": { "$ref": "#/$defs/Instant" },
        "skipped": { "type": "boolean" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "VetVisitRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "vetVisit" }, "data": { "$ref": "#/$defs/VetVisitData" } } }] },
    "VetVisitData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "visitedOn"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "visitedOn": { "$ref": "#/$defs/Date" },
        "contactId": { "$ref": "#/$defs/NullableUuid" },
        "reason": { "type": ["string", "null"], "maxLength": 500 },
        "findings": { "$ref": "#/$defs/Note" },
        "diagnosis": { "type": ["string", "null"], "maxLength": 1000 },
        "treatment": { "type": ["string", "null"], "maxLength": 2000 },
        "costMinor": { "oneOf": [{ "$ref": "#/$defs/MoneyMinor" }, { "type": "null" }] },
        "currency": { "oneOf": [{ "$ref": "#/$defs/Currency" }, { "type": "null" }] },
        "fileIds": { "$ref": "#/$defs/FileIds" },
        "followUpOn": { "$ref": "#/$defs/NullableDate" }
      }
    },

    "ConditionRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "condition" }, "data": { "$ref": "#/$defs/ConditionData" } } }] },
    "ConditionData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "kind", "name"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "kind": { "enum": ["allergy", "chronic", "other"] },
        "name": { "$ref": "#/$defs/ShortText" },
        "severity": { "enum": ["mild", "moderate", "severe", null] },
        "diagnosedOn": { "$ref": "#/$defs/NullableDate" },
        "resolvedOn": { "$ref": "#/$defs/NullableDate" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "SymptomEntryRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "symptomEntry" }, "data": { "$ref": "#/$defs/SymptomEntryData" } } }] },
    "SymptomEntryData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "observedAt", "description"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "observedAt": { "$ref": "#/$defs/Instant" },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "severity": { "enum": ["mild", "moderate", "severe", null] },
        "fileIds": { "$ref": "#/$defs/FileIds" }
      }
    },

    "CareRoutineRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "careRoutine" }, "data": { "$ref": "#/$defs/CareRoutineData" } } }] },
    "CareRoutineData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "kind", "title", "schedule", "active"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "kind": { "enum": ["feeding", "walk", "grooming", "fleaTick", "deworming", "custom"] },
        "title": { "$ref": "#/$defs/ShortText" },
        "schedule": { "$ref": "#/$defs/Schedule" },
        "active": { "type": "boolean" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "CareCompletionRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "careCompletion" }, "data": { "$ref": "#/$defs/CareCompletionData" } } }] },
    "CareCompletionData": {
      "type": "object", "additionalProperties": false, "required": ["routineId", "petId", "occurrenceAt", "completedAt", "skipped"],
      "properties": {
        "routineId": { "$ref": "#/$defs/Uuid" },
        "petId": { "$ref": "#/$defs/Uuid" },
        "occurrenceAt": { "$ref": "#/$defs/Instant" },
        "completedAt": { "$ref": "#/$defs/Instant" },
        "skipped": { "type": "boolean" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "ReminderRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "reminder" }, "data": { "$ref": "#/$defs/ReminderData" } } }] },
    "ReminderData": {
      "type": "object", "additionalProperties": false, "required": ["title", "schedule", "active"],
      "properties": {
        "petId": { "$ref": "#/$defs/NullableUuid" },
        "title": { "$ref": "#/$defs/ShortText" },
        "schedule": { "$ref": "#/$defs/Schedule" },
        "active": { "type": "boolean" },
        "note": { "$ref": "#/$defs/Note" },
        "category": { "enum": ["walk", "medication", "grooming", "vetVisit", "weighIn", "other", null], "description": "What the reminder is about; drives icon and medication matching" },
        "audienceUserId": { "type": ["string", "null"], "minLength": 1, "maxLength": 64, "description": "null = everyone in the household; otherwise the only user notified. Push: must equal the actor when set to a non-null value" }
      }
    },

    "ReminderCompletionRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "reminderCompletion" }, "data": { "$ref": "#/$defs/ReminderCompletionData" } } }] },
    "ReminderCompletionData": {
      "type": "object", "additionalProperties": false, "required": ["reminderId", "occurrenceAt", "completedAt"],
      "properties": {
        "reminderId": { "$ref": "#/$defs/Uuid" },
        "occurrenceAt": { "$ref": "#/$defs/Instant" },
        "completedAt": { "$ref": "#/$defs/Instant" }
      }
    },

    "ReminderSnoozeRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "reminderSnooze" }, "data": { "$ref": "#/$defs/ReminderSnoozeData" } } }] },
    "ReminderSnoozeData": {
      "type": "object", "additionalProperties": false, "required": ["sourceType", "sourceId", "occurrenceAt", "snoozedUntil", "userId"],
      "properties": {
        "sourceType": { "enum": ["vaccination", "medication", "careRoutine", "reminder", "vetVisit"] },
        "sourceId": { "$ref": "#/$defs/Uuid" },
        "occurrenceAt": { "$ref": "#/$defs/Instant" },
        "snoozedUntil": { "$ref": "#/$defs/Instant" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Snoozes are per user; must equal the pushing user" }
      }
    },

    "DocumentRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "document" }, "data": { "$ref": "#/$defs/DocumentData" } } }] },
    "DocumentData": {
      "type": "object", "additionalProperties": false, "required": ["title", "category", "fileId"],
      "properties": {
        "petId": { "$ref": "#/$defs/NullableUuid" },
        "title": { "$ref": "#/$defs/ShortText" },
        "category": { "enum": ["vetRecord", "certificate", "receipt", "insurance", "photo", "labResult", "other"] },
        "fileId": { "$ref": "#/$defs/Uuid" },
        "linkedRecordType": { "oneOf": [{ "$ref": "#/$defs/RecordType" }, { "type": "null" }] },
        "linkedRecordId": { "$ref": "#/$defs/NullableUuid" }
      }
    },

    "ExpenseRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "expense" }, "data": { "$ref": "#/$defs/ExpenseData" } } }] },
    "ExpenseData": {
      "type": "object", "additionalProperties": false, "required": ["spentOn", "category", "amountMinor", "currency"],
      "properties": {
        "petId": { "$ref": "#/$defs/NullableUuid" },
        "spentOn": { "$ref": "#/$defs/Date" },
        "category": { "enum": ["vet", "food", "grooming", "insurance", "supplies", "medication", "boarding", "training", "other"] },
        "amountMinor": { "$ref": "#/$defs/MoneyMinor" },
        "currency": { "$ref": "#/$defs/Currency" },
        "note": { "$ref": "#/$defs/Note" },
        "fileId": { "$ref": "#/$defs/NullableUuid" }
      }
    },

    "ContactRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "contact" }, "data": { "$ref": "#/$defs/ContactData" } } }] },
    "ContactData": {
      "type": "object", "additionalProperties": false, "required": ["name", "role"],
      "properties": {
        "name": { "$ref": "#/$defs/ShortText" },
        "role": { "enum": ["vet", "clinic", "emergencyClinic", "groomer", "sitter", "trainer", "boarding", "other"] },
        "phone": { "type": ["string", "null"], "maxLength": 40 },
        "email": { "type": ["string", "null"], "maxLength": 254 },
        "address": { "type": ["string", "null"], "maxLength": 500 },
        "website": { "type": ["string", "null"], "maxLength": 500, "pattern": "^https?://" },
        "note": { "$ref": "#/$defs/Note" }
      }
    },

    "EmergencyCardRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "emergencyCard" }, "data": { "$ref": "#/$defs/EmergencyCardData" } } }] },
    "EmergencyCardData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "visibleFields", "isLost"],
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid", "description": "Unique per household: one card per pet" },
        "visibleFields": {
          "type": "array", "uniqueItems": true, "maxItems": 12,
          "items": { "enum": ["photo", "name", "species", "breed", "colour", "markings", "microchipId", "allergies", "conditions", "medications", "ownerDisplayName", "ownerPhone", "notes"] }
        },
        "ownerDisplayName": { "type": ["string", "null"], "maxLength": 100 },
        "ownerPhone": { "type": ["string", "null"], "maxLength": 40 },
        "notes": { "type": ["string", "null"], "maxLength": 1000 },
        "isLost": { "type": "boolean" },
        "lostSince": { "oneOf": [{ "$ref": "#/$defs/Instant" }, { "type": "null" }] },
        "lostMessage": { "type": ["string", "null"], "maxLength": 1000 }
      }
    },

    "QuantityUnit": { "enum": ["g", "kg", "oz", "lb", "cup", "can", "pouch", "tbsp"], "description": "Stored in the unit the user chose (explicit exception to the SI rule: kitchen units have no fixed mass)" },
    "Quantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },

    "CareLogRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "careLog" }, "data": { "$ref": "#/$defs/CareLogData" } } }] },
    "CareLogData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "kind", "occurredAt"],
      "description": "Append-only record of everyday care that happened (Pebble Log sheet). Fields not listed for a kind are forbidden for it.",
      "properties": {
        "petId": { "$ref": "#/$defs/Uuid" },
        "kind": { "enum": ["meal", "walk", "grooming", "medication"] },
        "occurredAt": { "$ref": "#/$defs/Instant" },
        "note": { "$ref": "#/$defs/Note" },
        "foodName": { "$ref": "#/$defs/ShortText" },
        "quantity": { "$ref": "#/$defs/Quantity" },
        "quantityUnit": { "$ref": "#/$defs/QuantityUnit" },
        "durationMin": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "groomingTasks": { "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 7,
          "items": { "enum": ["bath", "brushing", "nailTrim", "haircut", "teeth", "ears", "other"] } },
        "medicationName": { "$ref": "#/$defs/ShortText" },
        "medicationId": { "$ref": "#/$defs/Uuid" },
        "route": { "enum": ["oral", "topical"] },
        "doseText": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "dependentRequired": { "quantity": ["quantityUnit"], "quantityUnit": ["quantity"] },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "meal" } } },
          "then": { "required": ["foodName"], "properties": { "durationMin": false, "groomingTasks": false, "medicationName": false, "medicationId": false, "route": false, "doseText": false } } },
        { "if": { "properties": { "kind": { "const": "walk" } } },
          "then": { "required": ["durationMin"], "properties": { "foodName": false, "quantity": false, "quantityUnit": false, "groomingTasks": false, "medicationName": false, "medicationId": false, "route": false, "doseText": false } } },
        { "if": { "properties": { "kind": { "const": "grooming" } } },
          "then": { "required": ["groomingTasks"], "properties": { "foodName": false, "quantity": false, "quantityUnit": false, "durationMin": false, "medicationName": false, "medicationId": false, "route": false, "doseText": false } } },
        { "if": { "properties": { "kind": { "const": "medication" } } },
          "then": { "required": ["medicationName"], "properties": { "foodName": false, "quantity": false, "quantityUnit": false, "durationMin": false, "groomingTasks": false } } }
      ]
    },

    "MealPresetRecord": { "allOf": [{ "$ref": "#/$defs/Envelope" }, { "properties": { "type": { "const": "mealPreset" }, "data": { "$ref": "#/$defs/MealPresetData" } } }] },
    "MealPresetData": {
      "type": "object", "additionalProperties": false, "required": ["petId", "foodName", "quantity", "quantityUnit"],
      "description": "A usual meal for one-tap logging. The UI shows at most 4 per pet (most recently updated); the server does not cap the count.",
      "properties": {
