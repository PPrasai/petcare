# Runs inside the "web" container, which shares the API container's network namespace.
# The host Caddy (TLS, petcare.pprasai.io) forwards to 127.0.0.1:8002, published to :8080 here.
{
	admin off
	auto_https off
	servers {
		# Keep the client address the host Caddy put in X-Forwarded-For.
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	@backend path /api/* /cal/*
	handle @backend {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /srv
		# Hashed build assets never change; everything else (index.html, sw.js, manifest) must revalidate.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
